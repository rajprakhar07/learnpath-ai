# --- LLM (optional). Any OpenAI-compatible /chat/completions endpoint works. ---
# Leave LLM_API_KEY empty to run in offline "extractive" mode (no LLM calls).
#
# Free/low-cost examples (check each provider's current free tier and model names):
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.1-8b-instant
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=<a ":free" model id>
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   Local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  LLM_API_KEY=ollama
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# Some providers reject response_format=json_object. Set false if you get HTTP 400.
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=30

# --- App ---
DATA_DIR=./data
MAX_UPLOAD_MB=25
TOP_K=4
# Answerability gate (see README "How unsupported questions are detected")
MIN_COVERAGE=0.6
MIN_BM25_SCORE=0.5
